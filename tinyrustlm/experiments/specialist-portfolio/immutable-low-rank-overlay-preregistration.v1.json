  "validationRules": [
    "Validate the complete package and every base binding before exposing any target or changing the active composition.",
    "Reject a byte slice shorter than the fixed header, larger than maximumPackageBytes, or different from totalByteCount.",
    "Use checked integer arithmetic for every count, multiplication, addition, alignment, offset conversion, and slice boundary.",
    "Reject unknown magic, version, flags, tags, dtype values, field lengths, nonzero reserved bytes, and undeclared trailing bytes.",
    "Require targetCount from one through 256 and directory entries in strictly increasing tensorIndex order with no duplicate target.",
    "Require each target identity, shape, dtype, block size, rank, and dimensions to equal the already validated loaded base tensor.",
    "Require every package-level model and execution digest to equal the caller-provided cryptographic identity of the loaded base.",
    "Require each output factor start at the canonical aligned offset, each input factor immediately follow it, and the next target start at align64 of the prior input end.",
    "Require all padding between the directory, targets, and aligned file end to be zero so one logical package has one canonical byte representation.",
    "Require every factor payload SHA-256 and the caller-supplied full-package SHA-256 to match before parsing succeeds.",
    "Require every scale and factor value to be finite, every scale to be nonzero, and every rank component to contain at least one nonzero output and input value.",
    "Reject a factor rank greater than 64, rows, cols, or their minimum, and reject any factor byte count that is not the exact checked formula.",
    "Do not accept partial targets, sparse undeclared gaps, overlapping ranges, aliases, path references, external payloads, compression, or model-byte slicing.",
    "A validation, allocation, digest, decode, or shape failure is atomic and leaves the previously active composition and its KV state unchanged.",
    "Package validation does not establish training provenance, task quality, routing quality, browser portability, or release fitness."
  ],
  "runtimeMath": {
    "deltaWeightFormula": "delta[row,col]=sum(k=0..rank-1,output[k*rows+row]*input[k*cols+col])",
    "componentDotFormula": "scratch[k]=sum(col=0..cols-1,input[k*cols+col]*x[col])",
    "overlayOutputFormula": "y[row]=baseNativeMatvec(row,x)+scale*sum(k=0..rank-1,output[k*rows+row]*scratch[k])",
    "executionOrder": [
      "Run the loaded base tensor native f32, q8_0, q5_0, or q4_0 matvec into the caller output exactly once.",
      "Compute scratch components in increasing k order and columns in increasing col order using f32 multiply then f32 add.",
      "For each row in increasing order, accumulate output-factor products in increasing k order and add scale times that sum to the base output.",
      "For multiple additive overlays targeting one tensor, apply overlays in canonical full typed content-identity byte order."
    ],
    "scratchElements": "factorRank-f32-values-per-active-matvec-call",
    "baseTensorMutation": false,
    "factorMutation": false,
    "expandedDeltaTensor": false,
    "dequantizedModelShadow": false,
    "quantizedBaseBehavior": "use-existing-native-quantized-matvec-without-dequantize-requantize",
    "hiddenRetryOrOutputRepair": false
  },
  "compositionAndKvRules": {
    "routeTiming": "choose-one-validated-composition-before-generation",
    "fallback": "visible-champion-fallback-before-first-token",
    "compositionIdentity": "bind-base-ordered-members-execution-bindings-route-policy-and-kv-format",
    "additiveOrder": "sort-by-full-typed-content-identity-bytes",
    "orderSensitiveUseOfThisFormat": "reject",
    "activation": "validate-and-allocate-complete-reference-counted-graph-then-atomic-swap",
    "activationFailure": "preserve-prior-composition-and-prior-kv",
    "compositionChange": "flush-entire-kv-cache-before-next-token",
    "sameCompositionReuse": "permitted-only-when-full-composition-bound-kv-key-is-identical",
    "midGenerationSwitch": "reject-and-cancel-without-hidden-restart"
  },
