    "name": "Atomic Composition Graph",
    "magic": "ACG1",
    "version": 1,
    "byteOrder": "little-endian",
    "headerLength": 512,
    "memberEntryLength": 128,
    "alignment": 64,
    "maximumMemberCount": 64,
    "maximumBundleBytes": 536870912,
    "flags": {
      "value": 0,
      "unknownBits": "reject"
    },
    "acceptedCompositionSemantics": [
      {
        "name": "base-only",
        "tag": 0,
        "memberRule": "exactly-zero"
      },
      {
        "name": "additive",
        "tag": 1,
        "memberRule": "one-through-64"
      }
    ],
    "rejectedCompositionSemantics": [
      "replacement",
      "sequential",
      "dependent"
    ],
    "memberArtifactMagic": "SLO1",
    "bundleIdentity": "caller-supplied-SHA-256-over-every-exact-ACG1-byte",
    "unknownValuePolicy": "reject",
    "trailingBytePolicy": "reject"
  },
