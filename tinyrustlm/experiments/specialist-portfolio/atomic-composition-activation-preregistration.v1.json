    }
  },
  "validationRules": [
    "Verify the caller-supplied full ACG1 SHA-256 before parsing any identity or package.",
    "Validate every header, identity, member, package, allocation bound, and byte-accounting field before publishing a prospective graph.",
    "Recompute the standalone identity from the exact loaded model byte count, model SHA-256, and all five execution bindings.",
    "Require the ACG1 base model byte count and SHA-256 to equal the already loaded immutable model.",
    "Accept only base-only with zero members or additive with one through 64 canonical SLO1 members.",
    "Recompute every base-dependent adapter identity from exact package bytes and require strictly increasing full typed member identities.",
    "Recompute the composition identity and require exact agreement with the declared composition typed identity.",
    "Require the route-policy typed identity to be nonzero and correctly typed; route-policy bytes and quality authority remain control-plane admission inputs rather than runtime inventions.",
    "Require the KV-format identity and position-policy digest to equal the exact runtime-supported descriptors.",
    "Recompute incremental and logical byte counts with checked arithmetic and reject any omitted base or member bytes.",
    "Reject gaps, overlaps, aliases, external package references, compression, nonzero padding, unknown fields, or trailing bytes.",
    "Parse and fully validate every embedded SLO1 package against the prospective base before allocating activation scratch.",
    "Allocate the complete immutable graph handle and maximum-rank scratch before the serialized commit point.",
    "A failure before commit leaves the old graph handle, old scratch, prompt tokens, generated tokens, exact-prefix authority, and KV cache unchanged.",
    "A successful activation with a different activeGraphDigest clears every token and KV position before another token can execute.",
    "Reactivating the exact same activeGraphDigest is idempotent and may preserve KV only when the full prompt-bound KV key also matches.",
    "No attention-frozen, MLP-only, layer-role, or target-tensor declaration grants cross-composition cache reuse.",
    "The runtime generation path snapshots one immutable reference-counted graph handle and cannot observe a partially built or mixed graph.",
    "Package validation and graph activation do not establish specialist training provenance, routing quality, model quality, browser behavior, or release fitness."
  ],
  "activationStateMachine": {
    "states": [
      "model-loaded-no-active-composition",
      "building-prospective-graph",
      "active-base-only",
      "active-additive",
      "model-freed"
    ],
    "buildOrder": [
      "verify-bundle-hash-and-envelope",
      "recompute-base-and-runtime-bindings",
      "parse-all-members",
      "recompute-composition-and-active-graph-identities",
      "allocate-complete-reference-counted-graph",
      "allocate-maximum-rank-scratch",
      "commit-one-serialized-swap"
    ],
    "sameGraph": "idempotent-no-op-preserving-current-cache-key",
    "differentGraph": "atomic-swap-then-full-token-and-kv-invalidation-before-next-token",
    "failure": "preserve-complete-prior-active-state",
    "midGenerationSwitch": "serialized-runtime-rejects-or-defers-before-commit-without-hidden-restart",
    "modelFree": "drop-active-handle-scratch-tokens-and-entire-kv-allocation"
  },
  "kvIsolationContract": {
    "owner": "exact-activeGraphDigest",
    "sequenceKey": "full-domain-separated-kv-cache-key-over-exact-retained-token-sequence",
    "hitRequirements": [
      "activeGraphDigest-equality",
      "composition-typed-id-equality",
      "tokenizer-digest-equality",
      "chat-template-digest-equality",
      "position-policy-digest-equality",
      "kv-format-typed-id-equality",
      "prompt-token-sequence-digest-equality",
      "execution-profile-digest-equality",
      "exact-retained-token-prefix-equality",
      "cache-length-equality"
    ],
    "fullFlushEvents": [
      "different-composition-activation",
      "different-route-bound-active-graph-activation",
      "different-kv-format-or-position-policy-activation",
      "context-reset",
      "generation-failure",
      "cancellation",
      "model-replacement",
      "model-free"
    ],
    "crossCompositionReuse": false,
    "partialPageReuse": false,
    "attentionFrozenShortcut": false
  },
