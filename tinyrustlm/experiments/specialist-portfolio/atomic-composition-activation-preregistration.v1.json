  "experimentId": "atomic-specialist-composition-activation-20260725",
  "status": "preregistered-no-runtime-authority",
  "scope": {
    "purpose": "Freeze one clean-slate atomic composition graph, activation, and composition-bound KV invalidation contract before replacing mutable adapter application.",
    "preReleaseRewrite": true,
    "legacyCompatibility": false,
    "acceptedLegacyMagics": [],
    "rejectedLegacyMagics": [
