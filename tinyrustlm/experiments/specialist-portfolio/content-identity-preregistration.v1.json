  "compositionSemantics": [
    {
      "name": "base-only",
      "tag": 0,
      "memberRule": "exactly-zero",
      "orderingRule": "none",
      "dependencyRule": "none"
    },
    {
      "name": "additive",
      "tag": 1,
      "memberRule": "one-or-more",
      "orderingRule": "sort-by-full-typed-identity-bytes",
      "dependencyRule": "all-empty"
    },
    {
      "name": "replacement",
      "tag": 2,
      "memberRule": "exactly-one",
      "orderingRule": "declared-order-is-material",
      "dependencyRule": "all-empty"
    },
    {
      "name": "sequential",
      "tag": 3,
      "memberRule": "one-or-more",
      "orderingRule": "declared-order-is-material",
      "dependencyRule": "all-empty"
    },
    {
      "name": "dependent",
      "tag": 4,
      "memberRule": "one-or-more",
      "orderingRule": "declared-topological-order-is-material",
      "dependencyRule": "sorted-unique-earlier-member-typed-identities"
    }
  ],
  "validationRules": [
    "Every required SHA-256 value is exactly 32 bytes and is not the all-zero sentinel.",
    "A standalone model must parse as one complete SLM artifact; adapter bytes cannot be presented as a standalone model.",
    "A base-dependent adapter must parse as one complete adapter artifact and bind one exact standalone base plus tokenizer, chat template, tensor layout, quantization, and execution profiles.",
    "Every composition member is a base-dependent-adapter typed identity and must bind the composition base and all five composition profiles.",
    "Version one compositions are homogeneous: every member semantic equals the composition semantic.",
    "Duplicate composition members, duplicate route members, duplicate selector artifacts, duplicate chunks, and duplicate dependency identities are rejected.",
    "Additive members are sorted before hashing and therefore commute; replacement, sequential, and dependent order remains material.",
    "A dependent member may reference only sorted unique members that appear earlier in the declared topological order.",
    "Unknown kind tags, semantic tags, metric tags, fields, trailing bytes, integer overflow, zero byte lengths, and list counts beyond implementation bounds are rejected.",
    "A missing quality receipt rejects automatic routing and promotion; quality receipts and timestamps never enter content identity."
  ],
  "storageLayout": {
    "domain": "tinyrustlm.content.storage-layout.v1",
    "fieldOrder": [
      "contentVersion",
      "targetArtifactTypedId",
      "logicalArtifactBytes",
      "chunkCount",
      "orderedChunkTypedIdAndByteCountPairs"
    ],
    "rules": [
      "Storage layout is not an executable artifact kind and cannot replace the target logical identity.",
      "Every member is a shared-chunk typed identity whose declared bytes match that chunk identity input.",
      "Ordered chunk bytes must sum exactly to logicalArtifactBytes.",
      "Reconstruction concatenates verified chunk bytes in declared order and must reproduce the target artifact byte count and SHA-256.",
      "Physical chunk deduplication does not reduce logical execution bytes."
    ]
  },
  "kvCacheKey": {
    "domain": "tinyrustlm.content.kv-cache-key.v1",
    "fieldOrder": [
      "contentVersion",
      "compositionTypedId",
      "tokenizerSha256",
      "chatTemplateSha256",
      "positionPolicySha256",
      "kvFormatTypedId",
      "promptTokenSha256",
      "executionProfileSha256"
    ],
    "rules": [
      "Version zero runtime behavior flushes every KV page on any composition change.",
      "No attention-frozen or MLP-only declaration authorizes cross-composition reuse.",
      "A cache hit requires exact equality of every key field."
    ]
  },
  "byteAccounting": {
    "requiredFields": [
      "standaloneArtifactBytes",
      "logicalCompositionBytes",
      "incrementalSpecialistBytes",
      "physicalPortfolioBytes",
      "routePolicyBytes",
      "retrievalIndexBytes",
      "kvFormatDescriptorBytes",
      "kvAllocatedBytes",
      "kvCommittedBytes",
      "kvPeakBytes",
      "activationScratchBytes",
      "decodedTemporaryBytes",
      "peakResidentBytes"
    ],
    "rules": [
      "logicalCompositionBytes equals the complete base bytes plus every required adapter byte and cannot be reduced by physical deduplication.",
      "incrementalSpecialistBytes excludes an already-present immutable base but includes every additional specialist byte required by that composition.",
      "physicalPortfolioBytes sums each verified stored object exactly once by full typed identity.",
      "Route policy, retrieval index, KV descriptor, runtime KV, scratch, decoded temporary, and peak resident bytes remain separate fields and cannot be hidden in another category.",
      "All additions use checked u64 arithmetic; omitted, negative, fractional, inferred, or overflowed byte values are rejected."
    ]
  },
