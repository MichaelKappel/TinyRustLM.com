{
  "name": "tinyrustlm-browser-acceptance",
  "version": "0.0.0-private",
  "private": true,
  "description": "Browser acceptance tests for the TinyRustLM web-to-companion boundary.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate:vnext-campaign-evidence-wasm": "node tools/vnext-campaign-evidence-wasm-codegen.js --write",
    "generate:vnext-authority-rust-vectors": "node tools/vnext-authority-rust-vectors.js --write",
    "generate:vnext-campaign-projection-rust-vectors": "node tools/vnext-campaign-projection-rust-vectors.js --write",
    "generate:vnext-offline-bundle-rust-vectors": "node tools/vnext-offline-bundle-rust-vectors.js --write",
    "generate:vnext-phase-invalidation-rust-vectors": "node tools/vnext-phase-invalidation-rust-vectors.js --write",
    "generate:prompt2-format-vectors": "node tools/prompt2-reference.js --write",
    "generate:slm2-runtime-vectors": "node tools/slm2-runtime-reference.js --write",
    "generate:sampling2-format-vectors": "node tools/sampling2-reference.js --write",
    "generate:template2-format-vectors": "node tools/template2-reference.js --write",
    "generate:tokenizer2-format-vectors": "node tools/tokenizer2-reference.js --write",
    "demo:start": "node tools/interview-demo-server.js",
    "demo:preflight": "node tools/interview-demo-preflight.js --ui",
    "demo:preflight:live": "node tools/interview-demo-preflight.js --live-model",
    "demo:interview": "node tools/interview-demo-launcher.js",
    "test:demo:interview:no-browser": "node --test --test-concurrency=1 tests/interview-demo-preflight.test.js tests/interview-demo-server.test.js tests/interview-demo-launcher.test.js",
    "test:tokenizer2-wasm": "node --test tests/tokenizer2-wasm-boundary.test.js",
    "test:qwen-tokenizer2-browser-wasm-preregistration": "node --test tests/qwen-tokenizer2-browser-wasm-preregistration.test.js",
    "test:qwen-template2-parity-preregistration": "node --test tests/qwen-template2-parity-preregistration.test.js",
    "test:build-custody": "node --test tests/build-custody-owner.test.js",
    "test:windows-x64-msvc-environment": "node --test tests/windows-x64-msvc-environment.test.js",
    "test:windows-x64-msvc-environment-observation": "powershell -NoProfile -Command \"$env:TINYRUSTLM_REAL_MSVC_ENVIRONMENT_OBSERVATION='1'; node --test tests/windows-x64-msvc-environment-observation.test.js\"",
    "test:prompt2-format-vectors": "node --test tests/prompt2-format-vectors.test.js",
    "generate:vnext-signature-rust-vectors": "node tools/vnext-signature-rust-vectors.js --write",
    "test:unit": "node tools/run-vnext-unit-test-gate.js standard",
    "test:vnext-authority-rust-vectors": "node --test tests/vnext-authority-rust-vectors.test.js",
    "test:vnext-campaign-projection-rust-vectors": "node --test tests/vnext-campaign-projection-rust-vectors.test.js",
    "test:vnext-campaign-evidence-wasm": "node --test tests/vnext-campaign-evidence-wasm.test.js",
    "test:vnext-campaign-release-surface": "node tools/run-vnext-unit-test-gate.js release-surface",
    "test:vnext-release-cutover": "node --test tests/vnext-release-cutover.test.js",
    "test:vnext-campaign-runner": "node --test tests/vnext-campaign-runner.test.js",
    "test:vnext-offline-bundle-rust-vectors": "node --test tests/vnext-offline-bundle-rust-vectors.test.js",
    "test:vnext-phase-invalidation-rust-vectors": "node --test tests/vnext-phase-invalidation-rust-vectors.test.js",
    "test:slm2-runtime-vectors": "node --test tests/slm2-runtime-vectors.test.js",
    "test:slm2-runtime-wasm-conformance": "node --test tests/slm2-runtime-wasm-conformance.test.js",
    "test:model-runtime-worker": "node --test tests/model-runtime-worker.test.js",
    "test:model-runtime-worker-browser": "node --test tests/model-runtime-worker-browser.test.js",
    "test:sampling2-format-vectors": "node --test tests/sampling2-format-vectors.test.js",
    "test:template2-format-vectors": "node --test tests/template2-format-vectors.test.js",
    "test:tokenizer2-format-vectors": "node --test tests/tokenizer2-format-vectors.test.js",
    "test:vnext-protected-equality-private-loader": "node --preserve-symlinks --preserve-symlinks-main --test tests/vnext-protected-equality-private-loader.test.js",
    "test:vnext-signature-rust-vectors": "node --test tests/vnext-signature-rust-vectors.test.js",
    "test:vnext-subject-store": "node --test tests/vnext-subject-store.test.js",
    "test:ui": "node --test --test-concurrency=1 tests/browser-model-admission.test.js tests/companion-composition-install.test.js tests/model-runtime-client.test.js tests/model-runtime-worker.test.js tests/companion-capability.test.js tests/companion-capability-vectors.test.js tests/model-acquisition.test.js tests/site-release-browser.test.js tests/site-release-contract.test.js tests/static-shell-parity.test.js tests/web-deployment-manifest.test.js tests/web-release-browser-smoke.test.js",
    "pretest:deployment": "npm run verify:source-authority",
    "test:deployment": "node --test tests/deploy-tinyrustlm-web.test.js tests/web-deployment-manifest.test.js tests/web-deployment-custody.test.js",
    "verify:vnext-campaign-release-surface": "node tools/run-vnext-campaign-release-surface-gate.js verify",
    "presmoke:web-release-local": "npm run verify:source-authority",
    "smoke:web-release-local": "node tools/run-web-release-local-smoke.js",
    "test:browser-contract": "node --test tests/browser-model-admission.test.js tests/companion-composition-install.test.js tests/model-runtime-client.test.js tests/model-runtime-worker.test.js",
    "verify:source-authority": "node tools/verify-single-source-authority.js",
    "pretest:e2e:acquisition": "npm run verify:source-authority",
    "test:e2e:acquisition": "playwright test --config=playwright.config.js --workers=1 --retries=0 --forbid-only e2e/model-chooser.spec.js e2e/composition-cache.spec.js e2e/direct-p2p-composition.spec.js",
    "pretest:ui": "npm run verify:source-authority",
    "pretest:browser-contract": "npm run verify:source-authority"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
