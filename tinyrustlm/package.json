{
  "name": "tinyrustlm-browser-acceptance",
  "version": "0.0.0-private",
  "private": true,
  "description": "Browser acceptance tests for the TinyRustLM web-to-companion boundary.",
  "scripts": {
    "generate:vnext-campaign-plan-wasm": "node tools/vnext-campaign-plan-wasm-codegen.js --write",
    "generate:vnext-authority-rust-vectors": "node tools/vnext-authority-rust-vectors.js --write",
    "generate:vnext-campaign-projection-rust-vectors": "node tools/vnext-campaign-projection-rust-vectors.js --write",
    "generate:vnext-offline-bundle-rust-vectors": "node tools/vnext-offline-bundle-rust-vectors.js --write",
    "generate:vnext-phase-invalidation-rust-vectors": "node tools/vnext-phase-invalidation-rust-vectors.js --write",
    "generate:vnext-signature-rust-vectors": "node tools/vnext-signature-rust-vectors.js --write",
    "test:unit": "node --test tests/*.test.js",
    "test:vnext-authority-rust-vectors": "node --test tests/vnext-authority-rust-vectors.test.js",
    "test:vnext-campaign-projection-rust-vectors": "node --test tests/vnext-campaign-projection-rust-vectors.test.js",
    "test:vnext-campaign-plan-wasm": "node --test tests/vnext-campaign-plan-wasm.test.js",
    "test:vnext-offline-bundle-rust-vectors": "node --test tests/vnext-offline-bundle-rust-vectors.test.js",
    "test:vnext-phase-invalidation-rust-vectors": "node --test tests/vnext-phase-invalidation-rust-vectors.test.js",
    "test:vnext-signature-rust-vectors": "node --test tests/vnext-signature-rust-vectors.test.js",
    "test:ui": "node --test tests/browser-model-admission.test.js tests/browser-round-evidence.test.js tests/companion-bridge.test.js tests/fresh-browser-conversation.test.js tests/model-acquisition-v2.test.js tests/run-browser-round.test.js tests/site-release-browser.test.js tests/site-release-contract.test.js tests/static-shell-parity.test.js tests/web-deployment-manifest.test.js tests/web-release-browser-smoke.test.js",
    "test:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/deploy-tinyrustlm-web.test.ps1",
    "smoke:web-release-local": "node tools/web-release-local-smoke.js",
    "test:browser-contract": "node --test tests/browser-model-admission.test.js tests/fresh-browser-conversation.test.js tests/browser-round-evidence.test.js tests/run-browser-round.test.js",
    "run:browser-round": "node tools/run-browser-round.js",
    "qualify:models": "node tools/model-qualification-runner.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
