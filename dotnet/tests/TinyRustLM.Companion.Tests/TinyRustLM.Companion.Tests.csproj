<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <CompanionFixtureProject Include="..\..\tools\TinyRustLM.ConversionFixtureTool\TinyRustLM.ConversionFixtureTool.csproj" />
    <CompanionFixtureProject Include="..\..\tools\TinyRustLM.P2PSeedFixtureTool\TinyRustLM.P2PSeedFixtureTool.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyRustLM.Companion\TinyRustLM.Companion.csproj" />
    <ProjectReference Include="@(CompanionFixtureProject)" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tools\TinyRustLM.DirectSeedWireFixtureTool\TinyRustLM.DirectSeedWireFixtureTool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Bind fixtures to the actual project outputs, including owned artifacts builds. -->
  <Target Name="BindCompanionFixtureAssemblies" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="@(CompanionFixtureProject)" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="CompanionFixtureAssembly" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="TinyRustLM.Fixture.%(CompanionFixtureAssembly.Filename)"
                        Value="%(CompanionFixtureAssembly.FullPath)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\..\..\contracts\vnext\companion-source-operation-vectors.v1.json"
          Link="companion-source-operation-vectors.v1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\contracts\vnext\companion-loopback-capability-vectors.v2.json"
          Link="companion-loopback-capability-vectors.v2.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\contracts\vnext\qwen3-0.6b-base-source-lock.v2.json"
          Link="qwen3-0.6b-base-source-lock.v2.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
