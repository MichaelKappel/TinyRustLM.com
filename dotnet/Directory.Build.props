<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/MichaelKappel/TinyRustLM.com.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <Authors>TinyRustLM maintainers</Authors>
    <Company>TinyRustLM</Company>
    <Copyright>Copyright TinyRustLM maintainers</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://TinyRustLM.com/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>TinyRustLM;TinyRustLM.com;UAIX;UAIX.org;browser-local;p2pRuntime;p2pRuntime.com;p2pLLM;p2pLLM.com;MiniModel;MiniModel.org;SLM2;.slm;ACG2;Prompt2;Tokenizer2;Template2;Sampling2;AI;LLM;P2P;peer-to-peer;Rust;runtime;model-sharing;model-validation;protected-sdk</PackageTags>
    <PackageReleaseNotes>Prelaunch single-product SDK for exact mixed-Q8 SLM2 inspection, fail-atomic ACG2 composition activation, bounded Prompt2 and Sampling2 conversation execution, exact native-contract validation, immutable operation identities, and composition-bound fixed-piece direct transport. The package boundary is the sole current implementation: it contains no compatibility APIs, model aliases, response repair, announcement/catalog control plane, local memory-package facade, legacy model loader, host sampling knobs, diagnostics text, conversion authoring, training, routing, telemetry, or licensing internals.</PackageReleaseNotes>
    <TinyRustLmPackOptionalMemoryEndpoints Condition="'$(TinyRustLmPackOptionalMemoryEndpoints)' == ''">false</TinyRustLmPackOptionalMemoryEndpoints>
    <TinyRustLmPackPrivateConversion Condition="'$(TinyRustLmPackPrivateConversion)' == ''">false</TinyRustLmPackPrivateConversion>
    <VersionPrefix>0.1.8</VersionPrefix>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\docs\nuget\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
