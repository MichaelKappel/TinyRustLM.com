<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(TinyRustLmMemoryEndpointsPackageId)</PackageId>
    <Title>TinyRustLM UAIX Browser MemoryEndpoints Optional Connector</Title>
    <Summary>Optional offline-first TinyRustLM connector for conflict-safe MemoryEndpoints.com short-term and long-term .uai-style memory sync.</Summary>
    <Description>Optional TinyRustLM UAIX Browser .NET plugin for MemoryEndpoints.com memory coordination and offline-first synchronization. It provides credential-free outbox contracts with stable hashes and idempotency keys; capability-gated direct-CORS transport for single-parent mutations and server-assigned revisions; authoritative receipt lookup and verification; explicit conflicts and tombstones; idempotent device registration, rotation, and revocation; monotonic change pulls and authoritative heads; local stale-index reporting, safe retention, and compaction; deterministic adversarial retrieval; bounded guarded context packing; public-safe meeting-room coordination; and short-term or long-term .uai-style memory save and search. Users supply their own routes and session credential. The package contains no workspace secrets, user memory, telemetry backend, model weights, private training logic, model conversion authoring, or encryption-key handling.</Description>
    <PackageReleaseNotes>Production MemoryEndpoints distributed-sync v1 support with strict credential-free capability negotiation, exact direct-CORS route validation, deterministic cross-runtime body hashing and request fingerprints, durable receipt recovery, pull-before-push reconnect synchronization, explicit stale-parent and tombstone conflicts, device epoch rotation and revocation, redacted retention policy reads, and offline multi-tab outbox coordination. The hosted API uses one parentRevisionId and server-assigned syncRevisionId values; search is never revision authority.</PackageReleaseNotes>
    <IsPackable>$(TinyRustLmPackOptionalMemoryEndpoints)</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>TinyRustLM;TinyRustLM.MemoryEndpoints;TinyRustLM.com;MemoryEndpoints;MemoryEndpoints.com;LocalEndpoints;LocalEndpoints.com;UAIX;UAIX.org;UAIX.Browser;Browser;UAI;.uai;memory;short-term-memory;long-term-memory;agent-memory;offline-first;IndexedDB;outbox;idempotency;multi-tab;conflict-safe;multi-device;tombstone;device-revocation;checkpoint;stale-index;deterministic-retrieval;prompt-injection-defense;bounded-context;meeting-rooms;agent-coordination;optional-plugin;local-connect;connect-app;protected-sdk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
    <ProjectReference Include="..\TinyRustLM.Memory\TinyRustLM.Memory.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\MEMORY_HARNESS.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\MEMORY_ENDPOINTS_CONNECTOR.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\MEMORY_ENDPOINTS_DISTRIBUTED_SYNC_V1.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\API_BOUNDARY.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
