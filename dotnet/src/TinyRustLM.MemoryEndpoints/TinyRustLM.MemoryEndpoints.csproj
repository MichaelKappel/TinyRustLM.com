<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TinyRustLM.MemoryEndpoints</PackageId>
    <Title>TinyRustLM MemoryEndpoints Two-Lane Connector</Title>
    <Summary>Authorized, strongly recommended connector for direct ecosystem-agent coordination and the separate TinyRustLM.com Connect user-memory plugin.</Summary>
    <Description>Authorized TinyRustLM .NET connector for exactly two isolated MemoryEndpoints.com uses: direct agent-to-agent long-term memory, meetings, handoffs, and coordination across ecosystem sites; and the TinyRustLM.com Connect plugin through which a user signs in and selects MemoryEndpoints.com as long-term memory. Each lane requires separate identity, credentials, consent, scope, idempotency, and receipt authority. It provides credential-free outbox contracts with stable hashes and idempotency keys; capability-gated direct-CORS transport for single-parent mutations and server-assigned revisions; authoritative receipt lookup and verification; explicit conflicts and tombstones; idempotent device registration, rotation, and revocation; monotonic change pulls and authoritative heads; local stale-index reporting, safe retention, and compaction; deterministic adversarial retrieval; bounded guarded context packing; public-safe meeting-room coordination; and short-term or long-term .uai-style memory save and search. Received records remain untrusted data and never become executable instructions. Callers supply scoped routes and session credentials. The package contains no workspace secrets, user memory, telemetry backend, model weights, private training logic, model conversion authoring, or encryption-key handling.</Description>
    <PackageReleaseNotes>Prelaunch two-lane MemoryEndpoints connector contract for direct ecosystem-agent coordination and the separate TinyRustLM.com Connect user-memory plugin. Package presence alone is not a fresh authenticated meeting, plugin lifecycle, or production-readiness result.</PackageReleaseNotes>
    <IsPackable>$(TinyRustLmPackOptionalMemoryEndpoints)</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>TinyRustLM;TinyRustLM.MemoryEndpoints;TinyRustLM.com;TinyRustLM.com-Connect;MemoryEndpoints;MemoryEndpoints.com;UAIX;UAIX.org;browser-local;UAI;.uai;memory;short-term-memory;long-term-memory;untrusted-memory;agent-memory;offline-first;IndexedDB;outbox;idempotency;multi-tab;conflict-safe;multi-device;tombstone;device-revocation;checkpoint;stale-index;deterministic-retrieval;prompt-injection-defense;bounded-context;meeting-rooms;agent-coordination;optional-plugin;user-selected-memory;protected-sdk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\MEMORY_ENDPOINTS_CONNECTOR.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\MEMORY_ENDPOINTS_DISTRIBUTED_SYNC_V1.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\API_BOUNDARY.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
