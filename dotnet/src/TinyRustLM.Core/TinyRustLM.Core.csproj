<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(TinyRustLmCorePackageId)</PackageId>
    <Title>TinyRustLM / UAIX Browser p2pLLM Runtime SDK</Title>
    <Summary>Native-backed TinyRustLM .slm inspection, safe loading, generation, diagnostics, and p2pLLM runtime harness APIs.</Summary>
    <Description>Public TinyRustLM .NET SDK for .slm validation, safe model inspection and loading, p2pLLM.com runtime harness lifecycle operations, generation, step/reset, diagnostics, SDK version and capability queries, and protected Rust native runtime assets. This package backs the UAIX.Browser.p2pLLM.Runtime local feed identity without exposing conversion, quantization authoring, training, routing, telemetry, licensing, or model-authoring internals.</Description>
    <PackageTags>TinyRustLM;TinyRustLM.Core;TinyRustLM.com;UAIX;UAIX.org;UAIX.Browser;Browser;UAIX.Browser.p2pLLM.Runtime;p2pLLM;p2pLLM.com;SLM;.slm;AI;LLM;Rust;native;runtime;runtime-harness;model-validation;model-inspection;safe-loading;generate;diagnostics;protected-sdk</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\PACKAGE_SECURITY.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\artifacts\native\win-x64\tinyrustlm_native.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\native\win-x64\tinyrustlm_native.dll')" />
    <None Include="..\..\..\artifacts\native\linux-x64\libtinyrustlm_native.so" Pack="true" PackagePath="runtimes\linux-x64\native\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\native\linux-x64\libtinyrustlm_native.so')" />
    <None Include="..\..\..\artifacts\native\osx-x64\libtinyrustlm_native.dylib" Pack="true" PackagePath="runtimes\osx-x64\native\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\native\osx-x64\libtinyrustlm_native.dylib')" />
    <None Include="..\..\..\artifacts\native\osx-arm64\libtinyrustlm_native.dylib" Pack="true" PackagePath="runtimes\osx-arm64\native\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\native\osx-arm64\libtinyrustlm_native.dylib')" />
  </ItemGroup>
</Project>
