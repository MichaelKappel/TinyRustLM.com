<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(TinyRustLmP2PPackageId)</PackageId>
    <Title>TinyRustLM / UAIX Browser p2pRuntime P2P SDK</Title>
    <Summary>Metadata-bound p2pRuntime share, import, announcement, catalog, and MiniModel manifest workflows for .slm adoption.</Summary>
    <Description>Public TinyRustLM .NET SDK for p2pRuntime.com peer-to-peer .slm model sharing and import workflows: MiniModel manifest inspection, local piece verification, signed-manifest verification, share-kit metadata, announcement validation, catalog application and inspection, import receipts, and safe metadata handoff. This package backs the UAIX.Browser.p2pRuntime.P2P local feed identity while keeping peer discovery services, premium routing, publisher services, training, and model-authoring internals out of the package.</Description>
    <PackageTags>TinyRustLM;TinyRustLM.P2P;TinyRustLM.com;UAIX;UAIX.org;UAIX.Browser;Browser;UAIX.Browser.p2pRuntime.P2P;p2pRuntime;p2pRuntime.com;P2P;peer-to-peer;model-sharing;MiniModel;MiniModel.org;manifest;announcement;catalog;share-kit;import;receipt;SLM;.slm;AI;LLM;Rust;protected-sdk</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
    <ProjectReference Include="..\TinyRustLM.Core\TinyRustLM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\P2P_SHARE_FLOW.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\API_BOUNDARY.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
