<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TinyRustLM.P2P</PackageId>
    <Title>TinyRustLM p2pRuntime P2P SDK</Title>
    <Summary>Composition-bound fixed-piece direct transport for exact TinyRustLM SLM2 and ACG2 artifacts.</Summary>
    <Description>Public TinyRustLM .NET SDK for creating immutable four-MiB-piece share kits, inspecting canonical public-safe manifests, and create-only assembling exact SLM2 or ACG2 artifacts after hash and semantic admission. The package exposes no peer discovery, announcements, catalogs, signed-manifest compatibility layer, receipt sidecars, network fallback, model-byte proxy, training, or model-authoring internals.</Description>
    <PackageTags>TinyRustLM;TinyRustLM.P2P;TinyRustLM.com;UAIX;UAIX.org;browser-local;p2pRuntime;p2pRuntime.com;P2P;peer-to-peer;direct-transport;fixed-piece;model-sharing;MiniModel;MiniModel.org;manifest;assembly;SLM2;.slm2;ACG2;AI;LLM;Rust;protected-sdk</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
    <ProjectReference Include="..\TinyRustLM.Core\TinyRustLM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\P2P_SHARE_FLOW.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\docs\nuget\API_BOUNDARY.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
