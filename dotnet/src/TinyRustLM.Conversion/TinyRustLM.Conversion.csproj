<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TinyRustLM.Conversion</PackageId>
    <Title>TinyRustLM SLM2 Conversion Process Owner</Title>
    <Summary>Bounded create-only wrapper for the exact complete TinyRustLM Qwen3 composition converter.</Summary>
    <Description>Controlled local-feed process owner for the sole current complete tinyrustlm-convert transaction. It invokes only qwen3-composition for the exact Qwen3 mixed-Q8 SLM2, Tokenizer2, Template2, Sampling2, Prompt2, and ACG2 artifact set with expected model-lock, tokenizer-lock, and registered-profile identities; owns process-tree cancellation and bounded output; rejects reparse inputs; validates the exact ten-file terminal inventory, operation identity, attempt and pass receipts, component-receipt identities, and all six streamed artifact hashes; and exposes no component-success API.</Description>
    <IsPackable>$(TinyRustLmPackPrivateConversion)</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>TinyRustLM;TinyRustLM.Conversion;TinyRustLM.com;UAIX;UAIX.org;browser-local;p2pLLM;p2pLLM.com;SLM2;.slm;Tokenizer2;Qwen3;AI;LLM;Rust;conversion;converter;tinyrustlm-convert;local-feed;controlled-package;private-sdk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyRustLM.Core\TinyRustLM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\nuget\PACKAGE_SECURITY.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\..\artifacts\converter\win-x64\tinyrustlm-convert.exe" Pack="true" PackagePath="tools\win-x64\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\converter\win-x64\tinyrustlm-convert.exe')" />
    <None Include="..\..\..\artifacts\converter\win-x64\tinyrustlm-convert.exe" Pack="true" PackagePath="contentFiles\any\any\tinyrustlm\tools\win-x64\" PackageCopyToOutput="true" Visible="false" Condition="Exists('..\..\..\artifacts\converter\win-x64\tinyrustlm-convert.exe')" />
    <None Include="..\..\..\artifacts\converter\linux-x64\tinyrustlm-convert" Pack="true" PackagePath="tools\linux-x64\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\converter\linux-x64\tinyrustlm-convert')" />
    <None Include="..\..\..\artifacts\converter\linux-x64\tinyrustlm-convert" Pack="true" PackagePath="contentFiles\any\any\tinyrustlm\tools\linux-x64\" PackageCopyToOutput="true" Visible="false" Condition="Exists('..\..\..\artifacts\converter\linux-x64\tinyrustlm-convert')" />
    <None Include="..\..\..\artifacts\converter\linux-arm64\tinyrustlm-convert" Pack="true" PackagePath="tools\linux-arm64\" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\converter\linux-arm64\tinyrustlm-convert')" />
    <None Include="..\..\..\artifacts\converter\linux-arm64\tinyrustlm-convert" Pack="true" PackagePath="contentFiles\any\any\tinyrustlm\tools\linux-arm64\" PackageCopyToOutput="true" Visible="false" Condition="Exists('..\..\..\artifacts\converter\linux-arm64\tinyrustlm-convert')" />
  </ItemGroup>
</Project>
