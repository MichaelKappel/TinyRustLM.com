<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>UAIX.Browser.p2pRuntime.SeedHost</PackageId>
    <VersionPrefix>0.3.0</VersionPrefix>
    <Title>UAIX Browser p2pRuntime Seed Host</Title>
    <Summary>Native-verified P2P acquisition, immutable-source conversion, and independent .slm seed-lane orchestration.</Summary>
    <Description>Production .NET APIs for importing verified MiniModel peer pieces, downloading pinned Hugging Face source revisions, converting supported safetensors models locally, and serving user-approved .slm peer pieces. Bundled Rust executables remain authoritative for manifests, hashes, conversion receipts, model validation, composition graphs, and model assembly. The package includes no model weights, training system, hosted model bytes, or project-server model proxy.</Description>
    <PackageTags>UAIX;UAIX.org;UAIX.Browser;p2pRuntime;p2pRuntime.com;TinyRustLM;TinyRustLM.com;MiniModel;MiniModel.org;P2P;seed-host;model-sharing;SLM;.slm;Rust;native;offline-first</PackageTags>
    <PackageReleaseNotes>0.3.0 establishes the sole canonical companion contract with unversioned closed routes and no compatibility aliases. Verified peers import directly; when no complete peer is available, the companion uses resumable immutable-source download and local Rust conversion, then streams the validated .slm and its bound composition graph to the browser.</PackageReleaseNotes>
    <PackageReadmeFile>SEED_HOST.md</PackageReadmeFile>
    <PackageProjectUrl>https://TinyRustLM.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MichaelKappel/TinyRustLM.com.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Authors>UAIX.org; TinyRustLM.com; MiniModel.org</Authors>
    <Company>UAIX.org</Company>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SeedHostDependencyVersion>0.1.8</SeedHostDependencyVersion>
    <SeedHostUsePackagedDependencies Condition="'$(SeedHostUsePackagedDependencies)' == ''">false</SeedHostUsePackagedDependencies>
  </PropertyGroup>
  <ItemGroup Condition="'$(SeedHostUsePackagedDependencies)' != 'true'">
    <ProjectReference Include="..\TinyRustLM.Abstractions\TinyRustLM.Abstractions.csproj" />
    <ProjectReference Include="..\TinyRustLM.P2P\TinyRustLM.P2P.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SeedHostUsePackagedDependencies)' == 'true'">
    <PackageReference Include="$(TinyRustLmAbstractionsPackageId)" Version="[$(SeedHostDependencyVersion)]" />
    <PackageReference Include="$(TinyRustLmP2PPackageId)" Version="[$(SeedHostDependencyVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.2]" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.2]" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\SEED_HOST.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\artifacts\seed-host-native\win-x64\minimodel_native.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\win-x64\minimodel_native.dll')" />
    <None Include="..\..\..\artifacts\seed-host-native\win-x64\minimodel.exe" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\win-x64\minimodel.exe')" />
    <None Include="..\..\..\artifacts\seed-host-native\win-x64\tinyrustlm-slm-pack.exe" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\win-x64\tinyrustlm-slm-pack.exe')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-x64\libminimodel_native.so" Pack="true" PackagePath="runtimes\linux-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-x64\libminimodel_native.so')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-x64\minimodel" Pack="true" PackagePath="runtimes\linux-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-x64\minimodel')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-x64\tinyrustlm-slm-pack" Pack="true" PackagePath="runtimes\linux-x64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-x64\tinyrustlm-slm-pack')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-arm64\libminimodel_native.so" Pack="true" PackagePath="runtimes\linux-arm64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-arm64\libminimodel_native.so')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-arm64\minimodel" Pack="true" PackagePath="runtimes\linux-arm64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-arm64\minimodel')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-arm64\tinyrustlm-slm-pack" Pack="true" PackagePath="runtimes\linux-arm64\native\" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-arm64\tinyrustlm-slm-pack')" />
  </ItemGroup>
</Project>
