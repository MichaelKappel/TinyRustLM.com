<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>uaix-p2p-seed</AssemblyName>
    <PackageId>UAIX.Browser.p2pRuntime.SeedHost.Tool</PackageId>
    <VersionPrefix>0.1.10</VersionPrefix>
    <Title>UAIX Browser p2pRuntime Seed Host Tool</Title>
    <Summary>Installable uaix-p2p-seed tool for MiniModel .slm fleet and seed-lane operation.</Summary>
    <Description>Installable .NET tool and self-contained command application for user-run MiniModel .slm P2P seed fleets. It uses the UAIX Browser SeedHost library and reviewed Rust MiniModel binaries; it does not proxy model bytes through project infrastructure.</Description>
    <PackageTags>UAIX;UAIX.Browser;p2pRuntime;TinyRustLM;MiniModel;P2P;seed-host;dotnet-tool;SLM;.slm;Rust</PackageTags>
    <PackageReleaseNotes>0.1.10 adds the secure browser pairing bridge, durable import restart and resume, receipt-bound browser streaming, pairing revocation, and explicit transfer diagnostics to the installable seed-host command.</PackageReleaseNotes>
    <PackageReadmeFile>SEED_HOST.md</PackageReadmeFile>
    <PackageProjectUrl>https://TinyRustLM.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MichaelKappel/TinyRustLM.com.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Authors>UAIX.org; TinyRustLM.com; MiniModel.org</Authors>
    <Company>UAIX.org</Company>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>uaix-p2p-seed</ToolCommandName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyRustLM.SeedHost\TinyRustLM.SeedHost.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\nuget\SEED_HOST.md" Pack="true" PackagePath="\" />
    <!-- PackAsTool packages the publish output; these linked assets must enter that output exactly once. -->
    <None Include="..\..\..\artifacts\seed-host-native\win-x64\minimodel_native.dll" Pack="false" Link="runtimes\win-x64\native\minimodel_native.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\win-x64\minimodel_native.dll') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64')" />
    <None Include="..\..\..\artifacts\seed-host-native\win-x64\minimodel.exe" Pack="false" Link="runtimes\win-x64\native\minimodel.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\win-x64\minimodel.exe') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-x64\libminimodel_native.so" Pack="false" Link="runtimes\linux-x64\native\libminimodel_native.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-x64\libminimodel_native.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-x64\minimodel" Pack="false" Link="runtimes\linux-x64\native\minimodel" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-x64\minimodel') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-arm64\libminimodel_native.so" Pack="false" Link="runtimes\linux-arm64\native\libminimodel_native.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-arm64\libminimodel_native.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-arm64')" />
    <None Include="..\..\..\artifacts\seed-host-native\linux-arm64\minimodel" Pack="false" Link="runtimes\linux-arm64\native\minimodel" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\artifacts\seed-host-native\linux-arm64\minimodel') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-arm64')" />
  </ItemGroup>
  <Target Name="RemoveUnusedTinyRustLmRuntimeNativeFromSeedTool" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'tinyrustlm_native.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libtinyrustlm_native.so' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libtinyrustlm_native.dylib'" />
    </ItemGroup>
  </Target>
</Project>
