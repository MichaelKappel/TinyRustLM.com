<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TinyRustLM.CompositionInspector</AssemblyName>
    <RootNamespace>TinyRustLM.CompositionInspector</RootNamespace>
    <Title>TinyRustLM Read-Only Composition Inspector</Title>
    <Description>Read-only command surface for independent durable inspection of one exact Qwen3 complete-composition output.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyRustLM.Conversion\TinyRustLM.Conversion.csproj" />
  </ItemGroup>
  <Target Name="StageTinyRustLmCustodyScratchInspector"
          AfterTargets="Build"
          Condition="'$(TinyRustLmCustodyScratchInspectorSource)' != ''">
    <Error Condition="$([System.IO.Path]::IsPathFullyQualified('$(TinyRustLmCustodyScratchInspectorSource)')) != 'True'"
           Text="TinyRustLmCustodyScratchInspectorSource must be an absolute path." />
    <Error Condition="!Exists('$(TinyRustLmCustodyScratchInspectorSource)')"
           Text="TinyRustLmCustodyScratchInspectorSource does not exist." />
    <Copy SourceFiles="$(TinyRustLmCustodyScratchInspectorSource)"
          DestinationFiles="$(TargetDir)tinyrustlm-build-scratch-inspect.exe"
          SkipUnchangedFiles="false"
          UseHardlinksIfPossible="false"
          UseSymboliclinksIfPossible="false" />
  </Target>
</Project>
