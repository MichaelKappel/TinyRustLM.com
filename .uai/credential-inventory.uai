profile: tinyrustlm.credential-inventory.current.v1
updated_utc: 2026-08-28T00:00:00Z
sensitivity: metadata only; no credential values
canonical_memory: wiki/runtime-mirust/reports/tinyrustlm-enterprise-intake-and-production-runtime-clean-cut-memory-2026-08-28.md
report_decision_index: wiki/runtime-mirust/reports/tinyrustlm-report-intake-decision-index-2026-08-28.md

approved_secret_store: E:\Source\Rust\.local-secrets
rules:
  - Never copy tokens, passwords, invitation URLs, workspace keys, signing keys, private endpoints, or raw hosted-memory payloads into .uai, workspace files, Git, docs, prompts, logs, screenshots, URLs, reports, or deploy packages.
  - Direct MemoryEndpoints agent coordination and the TinyRustLM.com Connect user plugin use separate scoped credentials and identities.
  - User plugin credentials require explicit sign-in, consent, least privilege, expiration/rotation/revocation, and session-safe handling.
  - A credential's presence is not proof that a service operation occurred or that an account is configured correctly.
  - Redundant memory copies never duplicate credential values.

inventory_status:
  memory_endpoints_agent_coordination: authorized product lane; live credentials and account state not recorded here
  tinyrustlm_connect_plugin: authorized user lane; live credentials and account state not recorded here
  deployment_and_signing: consult approved private store and release authorization; never infer availability
