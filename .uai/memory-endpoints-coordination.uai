  local_fixture_report_sha256: fc2af9fb86b03724d9444abdb976c43ce9e06ff3473167951b86d2611810cf57
  blocked_report: artifacts/reports/tinyrustlm-memory-endpoints-single-use-enrollment-live.json
  blocked_report_sha256: 9729a08dc17e988bc5e2364fde28f4f29998568ede0bcb3a8440cf3a73fc00ef
