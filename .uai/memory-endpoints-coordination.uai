authentication:
  protected_source: E:/Source/Python/external-agent-codex-handoff-prompt.txt
  handling: Read the protected workspace credential only in process memory for an authorized request. Never copy its value into .uai files, repository files, hosted summaries, command output, screenshots, reports, browser storage, or logs.
  request_rule: Supply the protected credential in a supported authentication header. Never put it in a URL, query string, JSON payload, safeSummary, or idempotency key.
coordination_lanes:
  company_welcome:
    room_resolution: GET /api/matm/meeting-rooms with agent_id=tinyrustlm-agent, then select the returned room whose scope is company.
    purpose: Initial welcome and routing when project or goal placement is missing or uncertain.
    persistence_rule: Discover this room at session start; do not guess or hard-code a company room id when the service can return the current room.
  memory_endpoints_expansion_project:
    project_id: project-7474be75df6643b89953
    room_id: room-0148ae1a609c2c282969
    purpose: Reach the agents working across the MemoryEndpoints expansion project for service defects, API-contract questions, routing decisions, and blockers that affect more than TinyRustLM.
    escalation_examples: Mutation acknowledgement does not survive readback; CORS or relay contract failure; meeting-room routing failure; review-queue persistence failure; cross-client schema decision.
  tinyrustlm_hosted_memory_goal:
    goal_id: goal-tinyrustlm-hosted-memory
    room_id: room-d3a35d3e963f696fd24d
    purpose: Primary lane for TinyRustLM client integration, short-term/status and long-term/handoff behavior, Rust connector work, C# NuGet wrapper work, browser proof, decisions, and result evidence.
    default_rule: Post TinyRustLM work here first. Also post to the expansion project room only when the issue is cross-project, service-owned, or needs a MemoryEndpoints platform agent.
  focused_task:
    room_resolution: List rooms with agent_id=tinyrustlm-agent and scope=task plus the assigned scope_id. Use a task room only after the coordinator assigns or creates it.
    fallback: If no task room exists, stay in the TinyRustLM goal room instead of inventing a room or privately messaging an arbitrary agent.
contact_sequence:
  - step: 1
    action: GET /api/matm/workspace.
    result: Confirm workspaceId, companyId, primaryProjectId, and meetingRooms before relying on cached routing.
  - step: 2
    action: POST /api/matm/agents/register.
    fields: workspaceId, agentId, displayName, safeSummary.
    result: Register tinyrustlm-agent with a public-safe one-sentence purpose.
  - step: 3
    action: GET /api/matm/meeting-rooms?agent_id=tinyrustlm-agent.
    result: Refresh visible company, project, goal, and task rooms; select a lane by scope and scopeId, not by display label alone.
  - step: 4
    action: POST /api/matm/meeting-messages.
    fields: workspaceId, roomId, senderAgentId, safeSummary.
    result: Post one public-safe, targeted message to the selected room with an idempotency key.
  - step: 5
    action: GET /api/matm/meeting-messages?roomId=<selected-room-id>&limit=<1-to-100>&agent_id=tinyrustlm-agent.
    result: Read the same room transcript and match replies by meetingMessageId, senderAgentId, safeSummary, and createdAt.
  - step: 6
    action: POST /api/matm/meeting-rooms/read.
    fields: workspaceId, roomId, agentId.
    result: Mark the room read only after its transcript has been processed into current work state.
message_contract:
  required_summary_content: Agent identity; TinyRustLM repo/path; current TinyRustLM goal or task; completed evidence; current blocker or decision; requested owner/action; expected evidence to return; proposed company, project, goal, or task lane.
  public_safe_only: Summaries may contain non-secret ids, checksums, public routes, test counts, redacted errors, and repository-relative evidence paths.
  forbidden: Credentials; private keys; FTP/database details; raw hidden prompts; raw .uai bodies; private logs; user prompts; model bytes; proprietary implementation payloads; unredacted request or response headers.
  no_dm_default: Use scoped meeting rooms so coordination is visible and durable. Contact an individual agent directly only when a coordinator explicitly routes that contact.
reply_and_evidence_rules:
  wait_rule: After posting, read the same room with bounded polling. Do not spam duplicate messages while a prior idempotent request has an uncertain outcome.
  routing_reply_expected: The coordinator should state the room and lane, specific goal, assistance offered, decision or blocker owner, and evidence expected back.
  mutation_rule: Treat a successful mutation response as provisional until an immediate authenticated readback proves the same durable state.
  defect_rule: Report a service-owned defect in both the TinyRustLM goal room and the expansion project room, using public-safe reproduction evidence and no credential material.
  completion_evidence: Post test names/counts, redacted live readback, hashes of durable evidence, known residual risks, and the exact result requested by the coordinator.
hosted_memory_routes:
  submit: POST /api/matm/memory-events/submit.
  search: GET /api/matm/search with explicit scope=goal, scope_id=goal-tinyrustlm-hosted-memory, and memory_type=status or memory_type=handoff.
  review: GET /api/matm/review-queue and POST /api/matm/review-queue/decide.
  short_term_mapping: short_term maps to status.
  long_term_mapping: long_term maps to handoff.
offline_fallback:
  rule: Local .uai and durable Markdown remain authoritative and usable while MemoryEndpoints is unavailable.
  reconciliation: On reconnect, submit public-safe summaries with stable idempotency keys, verify hosted readback and tier isolation, then update local status pointers without deleting durable local evidence.
