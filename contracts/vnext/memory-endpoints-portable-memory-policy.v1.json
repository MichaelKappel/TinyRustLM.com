{
  "schema": "tinyrustlm.memory_endpoints_portable_memory_policy.v1",
  "status": "current",
  "effectiveUtc": "2026-08-28T00:00:00Z",
  "authority": {
    "decision": "superseding_product_policy",
    "source": "explicit_project-owner_correction",
    "architectureRecord": "docs/architecture/2026-08-26-memoryendpoints-portable-memory-authority.md"
  },
  "localFile": {
    "supported": true,
    "offlineCapable": true,
    "deviceLocal": true,
    "requiredForPortableUse": false
  },
  "memoryEndpoints": {
    "authorization": "authorized",
    "recommendation": "strongly_recommended",
    "serviceOrigin": "https://memoryendpoints.com",
    "productRole": "two_lane_agent_coordination_and_tinyrustlm_connect_memory",
    "usesExactly": [
      "ecosystem_agent_coordination",
      "tinyrustlm_connect_user_plugin"
    ],
    "ecosystemAgentCoordination": {
      "directUse": true,
      "audience": "agents_working_across_all_ecosystem_sites",
      "capabilities": [
        "agent_to_agent_long_term_memory",
        "meetings",
        "handoffs",
        "coordination"
      ]
    },
    "tinyRustLmConnectUserPlugin": {
      "pluginName": "TinyRustLM.com Connect",
      "userSignsInToMemoryEndpoints": true,
      "longTermMemoryProvider": true,
      "crossDeviceContinuity": true,
      "worldwideAccess": true,
      "explicitUserChoiceRequired": true
    },
    "laneSeparation": {
      "sharedCredentialsAllowed": false,
      "sharedIdentityOrConsentAllowed": false,
      "sharedReceiptAuthorityAllowed": false
    },
    "replacesLocalFileSupport": false
  },
  "userControl": {
    "explicitOptInRequired": true,
    "silentUploadAllowed": false,
    "localOnlyChoiceAllowed": true,
    "disconnectAndClearControlsRequired": true
  },
  "privacy": {
    "modelUploadAllowed": false,
    "automaticRawPromptUploadAllowed": false,
    "credentialInUrlAllowed": false,
    "credentialInRepositoryAllowed": false,
    "memoryRecordsRequireBoundedTypedContracts": true
  },
  "claimBoundary": {
    "reachabilityIsLifecycleProof": false,
    "configuredCodeIsLifecycleProof": false,
    "authenticatedSaveSearchRestoreRequiresFreshReadback": true,
    "campaignCreditRequiresFreshReceipt": true
  },
  "prelaunchRedundancy": {
    "additionalLongTermMemoryCopiesAllowed": true,
    "purpose": "resilience_during_prelaunch",
    "everyMaintainedCopyMustStayCurrent": true,
    "provenanceLabelsRequired": true,
    "contradictoryCopiesAllowed": false,
    "credentialSafeCopiesRequired": true
  },
  "history": {
    "preserveImmutableEarlierEvidence": true,
    "earlierExclusionIsCurrentPolicy": false,
    "runtimeTranslationOfHistoricalRecordsRequired": false
  }
}
