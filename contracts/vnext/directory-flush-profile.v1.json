{
  "schema": "tinyrustlm.vnext.directory_flush_profile.v1",
  "profileId": "tinyrustlm.vnext.directory-flush.v1",
  "status": "frozen",
  "versionPolicy": "single-current-profile-no-compatibility-reader",
  "requestSchema": "tinyrustlm.vnext.directory_flush_request.v1",
  "successObservationSchema": "tinyrustlm.vnext.directory_flush_observation.v1",
  "failureSchema": "tinyrustlm.vnext.directory_flush_failure.v1",
  "networkAccess": "forbidden",
  "rawPathOutput": "forbidden",
  "rawHostErrorOutput": "forbidden",
  "requestTransport": "bounded-stdin-json",
  "responseTransport": "single-stdout-json-document",
  "requestMaximumBytes": 16384,
  "pathContract": {
    "ownedRoot": "absolute-existing-directory-with-no-symbolic-link-or-reparse-component",
    "relativeDirectory": "one-to-64-normal-components-beneath-canonical-owned-root",
    "maximumPathUtf8Bytes": 16384,
    "maximumRelativeComponents": 64,
    "maximumComponentUtf8Bytes": 255,
    "canonicalContainmentRequired": true,
    "preOpenInspectionRequired": true,
    "openedHandleMetadataInspectionRequired": true,
    "postFlushInspectionRequired": true,
    "singleWriterOwnershipRequired": true,
    "singleWriterMeaning": "the caller prevents independent path mutation from initial inspection through post-flush inspection"
  },
  "operationIdContract": {
    "minimumBytes": 3,
    "maximumBytes": 160,
    "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"
  },
  "directoryIdentity": {
    "algorithm": "sha256",
    "domain": "tinyrustlm.directory-flush.scope.v1",
    "material": "utf8(canonical-absolute-owned-root) || 0x00 || utf8(normalized-relative-directory)",
    "rawMaterialReturned": false
  },
  "platformMethods": {
    "windows": {
      "method": "win32-backup-semantics-flush-file-buffers",
      "requiredAccess": "GENERIC_WRITE",
      "shareMode": [
        "FILE_SHARE_READ",
        "FILE_SHARE_WRITE",
        "FILE_SHARE_DELETE"
      ],
      "flags": [
        "FILE_FLAG_BACKUP_SEMANTICS",
        "FILE_FLAG_OPEN_REPARSE_POINT"
      ],
      "flushCall": "Rust File::sync_all over the opened directory handle",
      "successMeaning": "the platform open, handle metadata inspection, sync_all, and post-flush path inspection returned success"
    },
    "unix": {
      "method": "posix-directory-fsync",
      "requiredAccess": "read",
      "flushCall": "Rust File::sync_all over the opened directory descriptor",
      "successMeaning": "the platform open, descriptor metadata inspection, sync_all, and post-flush path inspection returned success"
    },
    "other": {
      "method": "unsupported-platform",
      "policy": "fail-closed"
    }
  },
  "successObservationFields": [
    "architecture",
