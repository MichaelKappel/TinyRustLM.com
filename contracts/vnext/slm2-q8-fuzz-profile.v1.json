{
  "schema": "tinyrustlm.slm2-q8-fuzz-profile.v1",
  "profileId": "tinyrustlm.slm2-q8-fuzz/1",
  "version": 1,
  "status": "implemented-unpromoted",
  "formatProfileId": "org.minimodel.slm2/2.0",
  "formatProfileSha256": "5ac819cb31a17a64bec0d5492962a4baf0bd2778f6213b87c85c0a04f3a738d8",
  "weightProfileId": "tinyrustlm.weight-q8-row-symmetric-f32-scale/1",
  "weightProfileSha256": "7e931fd23fa8f6a90c53e4c14c5630eef8ce87e0f0902acd5a5e2df03c60733a",
  "input": {
    "kind": "raw-complete-mixed-q8-slm2-artifact-bytes",
    "maximumBytes": 1048576,
    "emptyInput": "parser-rejection",
    "oversizedInput": "harness-rejection-before-parser"
  },
  "validationPolicy": {
    "maximumFileBytes": 1048576,
    "maximumTensors": 4096
  },
  "target": {
    "parser": "tinyrustlm_slm2::validate_model",
    "acceptedArtifactChecks": [
      "identity-byte-length-equals-input-length",
      "identity-sha256-equals-independent-sha256",
      "piece-manifest-byte-length-equals-input-length",
      "piece-manifest-sha256-equals-independent-sha256",
      "piece-manifest-sha256-equals-model-identity",
      "tensor-count-within-policy",
      "tensor-registry-matches-public-required-registry",
      "mixed-q8-f32-role-partition-is-exact",
      "all-payload-ranges-within-input"
    ],
    "rejectedArtifactChecks": [
      "stable-error-code-is-in-allowlist",
      "no-panic",
      "no-activation",
      "no-output-file",
      "no-network"
    ]
  },
  "allowedParserErrorCodes": [
    "slm2-file-size-limit",
    "slm2-file-size-mismatch",
    "slm2-invalid-byte-order",
    "slm2-invalid-format-id",
    "slm2-invalid-header",
    "slm2-invalid-header-flags",
    "slm2-invalid-header-size",
    "slm2-invalid-magic",
    "slm2-invalid-manifest-size",
    "slm2-invalid-metadata",
    "slm2-invalid-model-metadata",
    "slm2-invalid-payload-layout",
    "slm2-invalid-q8-payload",
    "slm2-invalid-quantization",
    "slm2-invalid-section",
    "slm2-invalid-section-layout",
    "slm2-invalid-string-table",
    "slm2-invalid-tensor",
    "slm2-invalid-tensor-encoding",
    "slm2-invalid-tensor-order",
    "slm2-invalid-tensor-registry",
    "slm2-io",
    "slm2-layout-hash-drift",
    "slm2-nonfinite-f32",
    "slm2-nonzero-padding",
    "slm2-offset-overflow",
    "slm2-payload-hash-drift",
    "slm2-profile-drift",
    "slm2-tensor-size-mismatch",
    "slm2-trailing-bytes",
    "slm2-truncated-header",
    "slm2-unsupported-artifact-class",
    "slm2-unsupported-table",
    "slm2-unsupported-version"
  ],
  "seedClasses": [
    "canonical-valid-mixed-q8-vector",
    "truncated-envelope",
    "slm1-envelope",
    "registered-q8-hostile-mutation"
  ],
  "stableReplay": {
    "manifestSchema": "tinyrustlm.slm2-q8-fuzz-corpus.v1",
    "manifestStatus": "frozen",
    "exactSeedSetRequired": true,
    "seedSymlinksAllowed": false,
    "manifestMaximumBytes": 131072,
    "maximumEntries": 256
  },
  "prohibited": [
    "unbounded-input-forwarding",
    "panic-as-rejection",
    "parser-output-repair",
    "best-of-n-parser-selection",
    "activation-of-fuzzed-artifacts",
    "second-production-encoding",
    "legacy-reader",
    "compatibility-alias",
    "runtime-repacking",
    "network-access",
    "model-byte-publication",
    "fuzz-result-as-production-qualification"
  ]
}
