{
  "schema": "tinyrustlm.build-custody-profile.v1",
  "profileId": "tinyrustlm.source-controlled-build-custody/1",
  "status": "current-prelaunch-only",
  "platform": "win32",
  "architecture": "x64",
  "authority": {
    "productLifecycle": "prelaunch-single-product",
    "owner": "tinyrustlm/tools/build-custody-owner.js",
    "runtime": "exact-source-bound-node",
    "sourceControl": "exact-request-bound-git",
    "legacySupport": false,
    "compatibility": false,
    "migration": false,
    "fallback": false,
    "retry": false,
    "resume": false,
    "cleanupOnFailure": false,
    "staleOutputSelection": false
  },
  "schemas": {
    "request": "tinyrustlm.build-custody-request.v1",
    "binding": "tinyrustlm.build-custody-binding.v1",
    "start": "tinyrustlm.build-custody-start.v1",
    "processTerminal": "tinyrustlm.build-custody-process-terminal.v1",
    "terminal": "tinyrustlm.build-custody-terminal.v1",
    "summary": "tinyrustlm.build-custody-summary.v1"
  },
  "evidenceFiles": [
    "build.binding.json",
    "build.start.json",
    "build.stdout.bin",
    "build.stderr.bin",
    "build.process-terminal.json",
    "build.terminal.json"
  ],
  "limits": {
    "maximumRequestBytes": 262144,
    "maximumBindingBytes": 524288,
    "maximumTerminalBytes": 524288,
    "maximumArguments": 128,
    "maximumArgumentBytes": 32768,
    "maximumEnvironmentEntries": 128,
    "maximumEnvironmentValueBytes": 32768,
    "maximumDurationMilliseconds": 7200000,
    "maximumStdoutBytes": 16777216,
    "maximumStderrBytes": 16777216,
    "maximumTargetEntries": 131072,
    "maximumTargetBytes": 17179869184,
    "maximumRequiredOutputs": 16,
    "hashBufferBytes": 1048576
  },
  "rootPolicy": {
    "controlAndTargetMustBeAbsent": true,
    "parentsMustBeExistingDirectNonReparseDirectories": true,
    "rootsMustBeSiblingDirectories": true,
    "rootsMustNotOverlapSourceOrWorkingTree": true,
    "writeMode": "create-only",
    "existingRootIsTerminal": true
  },
  "processPolicy": {
    "shell": false,
    "stdin": "ignore",
    "stdout": "separate-bounded-binary-file",
    "stderr": "separate-bounded-binary-file",
    "environment": "exact-request-allowlist-only",
    "environmentLaunch": "dedicated-owner-clears-ambient-during-process-create-then-restores",
    "worker": "detached-same-owner-same-runtime",
    "workerEnvironment": "system-root-derived-only-no-caller-environment",
    "exitCaptureOrder": "child-exit-event-then-fsynced-process-terminal-before-diagnostics",
    "termination": "exact-hashed-windows-taskkill-tree-then-direct-kill",
    "retryCount": 0
  },
  "terminalStatuses": [
    "pass",
    "terminal-build-failure",
    "terminal-custody-failure"
  ],
  "successRule": "captured-exit-zero-and-no-signal-timeout-overflow-or-process-error-and-bounded-streams-closed-and-source-runtime-command-unchanged-and-all-required-outputs-exact",
  "failureRule": "preserve-every-created-root-and-write-create-only-process-and-overall-terminal-evidence-with-no-retry-resume-cleanup-adoption-or-selection",
  "claimBoundary": {
    "successfulBuild": "only-pass-terminal-with-zero-process-exit",
    "conversion": "not-assessed",
    "structuralComposition": "not-assessed",
    "nativeRuntime": "not-assessed",
    "browserWasm": "not-assessed",
    "modelQuality": "not-assessed",
    "publication": "not-assessed",
    "campaignCredit": "not-authorized"
  }
}
