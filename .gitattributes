###############################################################################
# Keep every detected text file LF-canonical in every checkout. Hash-bound
# source and generated identities must not depend on a developer's autocrlf
# setting or host operating system.
###############################################################################
* text=auto eol=lf

# Shell entry points are executed by Linux, WSL, and CI. Keep their shebangs
# and option lines canonical on Windows checkouts as well.
*.sh text eol=lf

# Hash-bound review sources and memory routes must survive Windows checkouts
# byte-for-byte. Their SHA-256 values are persisted in receipts and ledgers.
*.jsonl text eol=lf
*.uai text eol=lf
wiki/**/*.md text eol=lf
artifacts/**/*.json text eol=lf
artifacts/**/*.eval text eol=lf
tinyrustlm/models/*.manifest text eol=lf
tinyrustlm/models/*.runtime text eol=lf
tinyrustlm/models/*.eval text eol=lf
tinyrustlm/models/*.conversation text eol=lf
tinyrustlm/models/*.LICENSE.txt text eol=lf
tinyrustlm/models/*.NOTICE.md text eol=lf
tinyrustlm/app/app.js text eol=lf
tinyrustlm/app/models/*.manifest text eol=lf
tinyrustlm/app/models/*.conversation text eol=lf
tinyrustlm/app/models/*.LICENSE.txt text eol=lf
tinyrustlm/app/models/*.NOTICE.md text eol=lf

